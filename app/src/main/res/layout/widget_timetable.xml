<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_title_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/widget_app_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_plus_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_plus_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_widget_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Předchozí den"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_prev" />

            <TextView
                android:id="@+id/text_widget_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Pondělí"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_widget_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Další den"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_widget_today"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Dnešní rozvrh"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_today" />

        <ImageButton
            android:id="@+id/btn_widget_open"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Otevřít aplikaci"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_open" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_header"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Žádná výuka 🎉"
            android:textColor="#E0E7FF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_widget_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Dnes máš volno nebo prázdniny."
            android:textColor="#818CF8"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="6dp"
        android:scrollbars="none" />

</RelativeLayout>
